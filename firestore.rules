rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidStoragePhotoUrl(url) {
      return url == ''
        || url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/estudazz\\.firebasestorage\\.app/o/users%2F' + request.auth.uid + '%2Fprofile\\.jpg.*$')
        || url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/estudazz\\.appspot\\.com/o/users%2F' + request.auth.uid + '%2Fprofile\\.jpg.*$');
    }

    // Track 1: /tasks exige vinculo estrito com o dono e uid imutavel
    match /tasks/{taskId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.task_name is string
        && request.resource.data.task_name.size() > 0
        && request.resource.data.task_name.size() <= 200;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['task_completed', 'task_completed_at']);
    }

    // Track 2: /events exige vinculo estrito com o dono e uid imutavel
    match /events/{eventId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.event_name is string
        && request.resource.data.event_name.size() > 0
        && request.resource.data.event_name.size() <= 200;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['event_name', 'event_date']);
    }

    // Track 3 & 4: /users mantem apenas dados publicos (display_name, username, photoURL)
    // enquanto email, birth_date e dados academicos ficam restritos a /users/{uid}/private/profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && !('email' in request.resource.data)
        && !('birth_date' in request.resource.data)
        && !('institution' in request.resource.data)
        && !('course' in request.resource.data)
        && !('expected_graduation' in request.resource.data)
        && (!('photoURL' in request.resource.data) || isValidStoragePhotoUrl(request.resource.data.photoURL));
      allow update: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && !('email' in request.resource.data)
        && !('birth_date' in request.resource.data)
        && !('institution' in request.resource.data)
        && !('course' in request.resource.data)
        && !('expected_graduation' in request.resource.data)
        && (!('photoURL' in request.resource.data) || isValidStoragePhotoUrl(request.resource.data.photoURL));
      allow delete: if isOwner(userId);

      match /private/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.uid == userId
          && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      }
    }

    // Dados de contexto da IA pertencem exclusivamente ao proprio usuario
    match /ia-data/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 5000;
    }

    // Indice de unicidade de codigos de salas de estudo (busca pontual por get, sem listagem global)
    match /study_room_codes/{roomCode} {
      allow get: if isSignedIn() && roomCode.matches('^[A-Z0-9]{3}-[A-Z0-9]{3}$');
      allow list: if false;
      allow create: if isSignedIn()
        && roomCode.matches('^[A-Z0-9]{3}-[A-Z0-9]{3}$')
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.roomId is string;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.creatorUid == request.auth.uid;
    }

    // Track 5, 6, 7 & 8: Salas de estudo (listagem restrita a membros; roomCode privado do criador)
    match /study_rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members);

      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && !('roomCode' in request.resource.data);

      allow update: if isSignedIn()
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && !('roomCode' in request.resource.data)
        && (
          // Criador pode renomear a sala (mantendo membros inalterados)
          (
            resource.data.creatorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
          )
          ||
          // Qualquer usuario autenticado pode adicionar apenas o proprio uid em members
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && !(request.auth.uid in resource.data.members)
            && (request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
          )
          ||
          // Membro pode remover apenas o proprio uid ao sair da sala
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && (request.auth.uid in resource.data.members)
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
          )
        );

      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      match /private/{docId} {
        allow read, delete: if isSignedIn()
          && resource.data.creatorUid == request.auth.uid;
        allow create, update: if isSignedIn()
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.matches('^[A-Z0-9]{3}-[A-Z0-9]{3}$');
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/study_rooms/$(roomId)).data.members);
        allow create: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/study_rooms/$(roomId)).data.members)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/study_rooms/$(roomId)).data.creatorUid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
